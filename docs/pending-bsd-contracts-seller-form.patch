diff --git a/bsd-seller-fields.js b/bsd-seller-fields.js
new file mode 100644
index 0000000..de3cb3d
--- /dev/null
+++ b/bsd-seller-fields.js
@@ -0,0 +1,40 @@
+/* Seller agreement field rules. Classic script so the signing page and node tests share it. */
+(function (root) {
+  'use strict';
+
+  function israeliRegistrationNumber(value) {
+    var digits = String(value == null ? '' : value).replace(/\D/g, '');
+    return /^\d{9}$/.test(digits) ? digits : '';
+  }
+
+  function entityKindLabel(kind) {
+    if (kind === 'company' || kind === 'ח.פ.' || kind === 'ח.פ') return 'ח.פ.';
+    if (kind === 'osek' || kind === 'עוסק מורשה') return 'עוסק מורשה';
+    return '';
+  }
+
+  function sellerFieldErrors(fields) {
+    var errors = {};
+    if (!String((fields && fields.legalName) || '').trim()) {
+      errors.legalName = 'יש להקליד את השם המשפטי של העסק';
+    }
+    if (!israeliRegistrationNumber(fields && fields.idNumber)) {
+      errors.idNumber = 'יש להזין 9 ספרות';
+    }
+    if (!entityKindLabel(fields && fields.idKind)) {
+      errors.idKind = 'יש לבחור ח.פ. או עוסק מורשה';
+    }
+    if (!String((fields && fields.address) || '').trim()) {
+      errors.address = 'יש להזין כתובת';
+    }
+    return errors;
+  }
+
+  var api = {
+    israeliRegistrationNumber: israeliRegistrationNumber,
+    entityKindLabel: entityKindLabel,
+    sellerFieldErrors: sellerFieldErrors
+  };
+  root.BsdSellerFields = api;
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+})(typeof window !== 'undefined' ? window : globalThis);
diff --git a/tests/seller-fields.test.mjs b/tests/seller-fields.test.mjs
new file mode 100644
index 0000000..4fb8a6a
--- /dev/null
+++ b/tests/seller-fields.test.mjs
@@ -0,0 +1,46 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const api = require(join(dirname(fileURLToPath(import.meta.url)), '..', 'bsd-seller-fields.js'));
+
+const GERESH = "מאפיית ג׳וזף";
+const GERSHAYIM = "ג'ירפה בע״מ";
+
+test('a legal name with geresh or gershayim is accepted as typed', () => {
+  for (const name of [GERESH, GERSHAYIM, "בעמ ג'ו"]) {
+    const errors = api.sellerFieldErrors({
+      legalName: name,
+      idNumber: '514172036',
+      idKind: 'company',
+      address: 'הרצל 1',
+    });
+    assert.deepEqual(errors, {});
+    assert.equal(name.includes('׳') || name.includes("'") || name.includes('״'), true);
+  }
+});
+
+test('invalid company numbers are rejected', () => {
+  for (const id of ['', '12345678', '1234567890', '12-345', 'abcdefgh', '1234 5678']) {
+    const errors = api.sellerFieldErrors({
+      legalName: GERESH,
+      idNumber: id,
+      idKind: 'osek',
+      address: 'רחוב 1',
+    });
+    assert.equal(errors.idNumber, 'יש להזין 9 ספרות', id);
+  }
+});
+
+test('separators are fine when nine digits remain, and address and kind are required', () => {
+  assert.equal(api.israeliRegistrationNumber('51-417-2036'), '514172036');
+  assert.equal(api.entityKindLabel('osek'), 'עוסק מורשה');
+  const missing = api.sellerFieldErrors({ legalName: '  ', idNumber: '514172036', idKind: '', address: '' });
+  assert.ok(missing.legalName);
+  assert.ok(missing.idKind);
+  assert.ok(missing.address);
+  assert.equal(missing.idNumber, undefined);
+});
